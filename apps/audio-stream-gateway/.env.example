PORT=3000
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
YOUTUBE_API_KEY=your-youtube-api-key

# --- Access codes -----------------------------------------------------------------
# Each access code unlocks its own R2 bucket, so different codes see different music,
# different groups and a different YouTube login. The value is either the bucket name
# or an object with an optional label used in logs.
#
#   ACCESS_CODES={"alice-code":"kplayer-alice","bob-code":{"bucket":"kplayer-bob","label":"Bob"}}
#
# Buckets must already exist; the gateway never creates them. Two codes pointing at the
# same bucket are the same library with two keys.
ACCESS_CODES={"your-access-code":"yt-audio-cache"}

# Verifying a code returns a signed token that the app sends on every request. The secret
# defaults to a value derived from the codes, so tokens survive restarts; set this to
# rotate tokens without changing the codes.
# ACCESS_TOKEN_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=10080

# --- Single-tenant fallback -------------------------------------------------------
# Leave ACCESS_CODES unset to keep the previous behaviour: one bucket, optionally
# guarded by one code. Without ACCESS_CODE the gateway is open to anyone who can reach it.
# R2_BUCKET_NAME=yt-audio-cache
# ACCESS_CODE=your-access-code
